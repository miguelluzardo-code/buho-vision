# ── Búho Visión WhatsApp Bot ─────────────────────────────────────────
# Copiar a .env y completar.

# Zona horaria para "hoy", horarios y resúmenes
BOT_TZ=America/Montevideo

# Hora del resumen diario (HH:MM, hora local)
BOT_DIGEST_TIME=08:00

# Ignorar sesiones de más de N días (evita reflotar cosas viejas al arrancar)
BOT_MAX_AGE_DAYS=30

# Cada cuántos minutos se evalúan las reglas por tiempo (SLA, recordatorios)
BOT_TICK_MINUTES=5

# Prefijo de comandos dentro de los grupos
BOT_COMMAND_PREFIX=!

# 1 = no envía nada por WhatsApp, solo imprime en consola (ideal para probar)
BOT_DRY_RUN=0

# ── Firebase (mismo proyecto que la app: buhovision-5bee4) ───────────
# Opción A: ruta al JSON de la cuenta de servicio
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
# Opción B: el JSON completo en una sola línea (útil en Railway)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Si no hay Firebase, el bot lee este snapshot local (formato de la app)
BOT_LOCAL_DATA=./data/snapshot.json

# ── WhatsApp (whatsapp-web.js) ───────────────────────────────────────
# Chromium a usar (en Docker/Linux). Vacío = el que descarga puppeteer.
PUPPETEER_EXECUTABLE_PATH=
# Carpeta donde se guarda la sesión de WhatsApp (escaneás el QR una sola vez)
BOT_SESSION_DIR=./.wwebjs_auth

# Números de administradores (E.164 sin +). Reciben alertas críticas por privado.
BOT_ADMIN_PHONES=59899000000
